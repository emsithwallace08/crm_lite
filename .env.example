# Copy this file to .env.
#
# Option A — local Postgres via Docker (docker-compose.yml provided):
#   pnpm db:up   # starts Postgres in the background
DATABASE_URL="postgresql://crmlite:crmlite@localhost:5432/crmlite"

# Option B — free hosted Postgres (Neon https://neon.tech or Supabase https://supabase.com),
# no Docker required. Comment out the line above and uncomment/fill in this one instead:
# DATABASE_URL="postgresql://user:password@host.neon.tech:5432/crmlite?sslmode=require"
