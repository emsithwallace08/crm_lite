generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum DealStage {
  LEAD
  QUALIFIED
  PROPOSAL
  NEGOTIATION
  WON
  LOST
}

model Contact {
  id        String   @id @default(cuid())
  name      String
  email     String?  @unique
  phone     String?
  company   String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deals     Deal[]

  @@index([company])
}

model Deal {
  id                String    @id @default(cuid())
  title             String
  valueCents        Int
  stage             DealStage @default(LEAD)
  expectedCloseDate DateTime?
  contactId         String
  contact           Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([stage])
  @@index([contactId])
}
